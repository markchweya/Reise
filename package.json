{
  "name": "reise",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @reise/mobile",
    "dev:driver": "npm run dev --workspace @reise/driver",
    "build": "npm run build --workspace @reise/driver",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "expo": "~54.0.36",
    "expo-font": "~14.0.12",
    "expo-router": "~6.0.24",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
