# Shared Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only

# Optional hosted AI. The MVP defaults to the phone-memory local assistant.
EXPO_PUBLIC_AI_MODE=local
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional official Swiss transport data
OFFICIAL_TRANSPORT_API_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
EXPO_PUBLIC_DRIVER_BASE_URL=http://192.168.1.10:3000
GPS_FRESHNESS_THRESHOLD_SECONDS=20
GPS_UPDATE_INTERVAL_SECONDS=5
POSITION_RETENTION_DAYS=7
EXPO_PUBLIC_DATA_MODE=test
