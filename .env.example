# ---------------------------------------------------------------------------
# DEV ONLY. Copy to .env. Never commit .env.
# A key placed here is bundled into the JS you ship — treat it as public.
# For anything but your own phone, run server/ and point SOMA_PROXY_URL at it.
# ---------------------------------------------------------------------------

# Local dev escape hatch: talks straight to the model provider from the phone.
SOMA_DEV_API_KEY=
SOMA_DEV_BASE_URL=https://api.anthropic.com

# Preferred: the proxy in server/ holds the real key.
SOMA_PROXY_URL=http://192.168.1.10:8787

# 'proxy' (default) | 'direct' (dev only) | 'ondevice' (needs an EAS dev build)
SOMA_PROVIDER=proxy
